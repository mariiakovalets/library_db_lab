Project LibraryLab {
  database_type: 'PostgreSQL'
  Note: 'Library management system with additional services. 17 tables.'
}

//  Staff 

Table roles {
  id serial [pk]
  name varchar(50) [not null, unique, note: 'admin, librarian']
}

Table staff_users {
  id serial [pk]
  role_id int [not null, ref: > roles.id]
  full_name varchar(255) [not null]
  email varchar(255) [not null, unique]
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > staff_users.id]
}

//  Catalog: a book as an edition 

Table publishers {
  id serial [pk]
  name varchar(255) [not null, unique]
  address varchar(255)
  founded_year int
}

Table authors {
  id serial [pk]
  full_name varchar(255) [not null]
  birth_year int
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > staff_users.id]
}

Table genres {
  id serial [pk]
  name varchar(100) [not null, unique]
}

Table books {
  id serial [pk]
  isbn varchar(17) [not null, note: 'unique among non-deleted books']
  title varchar(255) [not null]
  publisher_id int [not null, ref: > publishers.id]
  genre_id int [not null, ref: > genres.id]
  publish_year int
  pages_count int
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > staff_users.id]
}

Table book_authors {
  book_id int [ref: > books.id]
  author_id int [ref: > authors.id]

  indexes {
    (book_id, author_id) [pk]
  }
}

//  Copies: physical items on the shelf 

Table book_copies {
  id serial [pk]
  book_id int [not null, ref: > books.id]
  inventory_number varchar(20) [not null, unique]
  status varchar(20) [not null, default: 'available', note: 'available | loaned | written_off']
  acquired_at date [not null, default: `current_date`]
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > staff_users.id]
}

//  Readers and memberships 

Table readers {
  id serial [pk]
  library_card_number varchar(20) [not null, unique]
  full_name varchar(255) [not null]
  email varchar(255) [note: 'unique among non-deleted readers']
  phone varchar(20)
  birth_date date
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > staff_users.id]
}

Table membership_plans {
  id serial [pk]
  name varchar(50) [not null, unique, note: 'Student, Standard, Premium']
  price numeric(10,2) [not null]
  duration_days int [not null]
  max_books int [not null, note: 'how many books a reader can hold at once']
  loan_days int [not null, note: 'loan period for one book']
}

Table reader_memberships {
  id serial [pk]
  reader_id int [not null, ref: > readers.id]
  plan_id int [not null, ref: > membership_plans.id]
  start_date date [not null]
  end_date date [not null]
  created_at timestamptz [not null, default: `now()`]
}

//  Circulation 

Table loans {
  id serial [pk]
  copy_id int [not null, ref: > book_copies.id]
  reader_id int [not null, ref: > readers.id]
  issued_by int [not null, ref: > staff_users.id]
  issued_at timestamptz [not null, default: `now()`]
  due_date date [not null]
  returned_at timestamptz [note: 'NULL while the book is with the reader']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > staff_users.id]
}

Table reservations {
  id serial [pk]
  book_id int [not null, ref: > books.id]
  reader_id int [not null, ref: > readers.id]
  reserved_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  status varchar(20) [not null, default: 'active', note: 'active | fulfilled | cancelled | expired']
}

Table fines {
  id serial [pk]
  loan_id int [not null, unique, ref: - loans.id, note: 'one fine per overdue loan']
  amount numeric(10,2) [not null]
  reason varchar(255) [not null]
  status varchar(20) [not null, default: 'unpaid', note: 'unpaid | paid']
  created_at timestamptz [not null, default: `now()`]
}

//  Additional services 

Table services {
  id serial [pk]
  name varchar(100) [not null, unique, note: 'printing, scanning, reading room seat, interlibrary loan, consultation']
  description varchar(500)
  price numeric(10,2) [not null, note: 'price per unit']
  unit varchar(20) [not null, note: 'page | hour | request']
  requires_schedule boolean [not null, default: false, note: 'true for reading room and consultation']
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > staff_users.id]
}

Table service_orders {
  id serial [pk]
  reader_id int [not null, ref: > readers.id]
  service_id int [not null, ref: > services.id]
  quantity int [not null, default: 1]
  total_price numeric(10,2) [not null]
  scheduled_at timestamptz [note: 'date and time for services that need booking']
  status varchar(20) [not null, default: 'new', note: 'new | completed | cancelled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz
  updated_by int [ref: > staff_users.id]
}

//  Payments 

Table payments {
  id serial [pk]
  reader_id int [not null, ref: > readers.id]
  amount numeric(10,2) [not null]
  method varchar(10) [not null, note: 'cash | card']
  paid_at timestamptz [not null, default: `now()`]
  received_by int [not null, ref: > staff_users.id]
  fine_id int [ref: > fines.id]
  reader_membership_id int [ref: > reader_memberships.id]
  service_order_id int [ref: > service_orders.id]
  Note: 'exactly one of fine_id, reader_membership_id, service_order_id is filled'
}

//  Groups on the canvas 

TableGroup staff {
  roles
  staff_users
}

TableGroup catalog {
  publishers
  authors
  genres
  books
  book_authors
  book_copies
}

TableGroup readers_group {
  readers
  membership_plans
  reader_memberships
}

TableGroup circulation {
  loans
  reservations
  fines
}

TableGroup extra_services {
  services
  service_orders
  payments
}
